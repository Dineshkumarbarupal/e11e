# Copy to server/.env for local development. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/e11e
REDIS_URL=redis://127.0.0.1:6379
# Generate a long random secret (at least 32 characters).
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Exactly 64 hexadecimal characters (32 random bytes).
CREDENTIAL_ENCRYPTION_KEY_HEX=replace-with-64-hex-characters
# Comma-separated explicit browser origins. Do not use * for authenticated production API.
CORS_ORIGINS=http://localhost:5173
# Exact HTTPS hostnames permitted by the secure server HTTP node. Empty means outbound HTTP is disabled.
HTTP_ALLOWED_HOSTS=
RATE_LIMIT_MAX=100
# Public webhook requests allowed per minute per source IP and webhook endpoint (process-local limiter).
WEBHOOK_RATE_LIMIT_MAX=60
