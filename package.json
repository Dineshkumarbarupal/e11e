{
  "name": "e11e-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test 26.00.00/theme/AppName_Basic/User/js/workflow-engine.test.js tests/canvas-layout.test.js tests/ui-assets.test.js tests/cron-schedule.test.js",
    "check": "node --check 26.00.00/theme/AppName_Basic/User/js/app.js && node --check 26.00.00/theme/AppName_Basic/User/js/workflow-engine.js && node --check 26.00.00/theme/AppName_Basic/User/js/canvas-layout.js && node --check 26.00.00/theme/AppName_Basic/User/js/cron-schedule.js",
    "server:dev": "npm --prefix server run dev",
    "server:worker": "npm --prefix server run worker",
    "server:migrate": "npm --prefix server run migrate",
    "server:scheduler": "npm --prefix server run scheduler"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
